  .file-item {
    display: flex; align-items: center;
    padding: 4px 6px 4px 12px; background: var(--color-surface);
    border: 1px solid var(--color-border); border-radius: 3px;
  }
  .file-name {
    font-family: var(--font-body); font-size: 11px; color: var(--color-body);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1;
  }
  .file-remove {
    background: none; border: none;
    cursor: pointer; padding: 2px 4px; margin-left: 6px;
    font-size: 10px; color: var(--color-body); line-height: 1;
    flex-shrink: 0; opacity: 0.5;
  }
  .file-remove:hover { opacity: 1; color: var(--color-brand); }

  /* Accordion */
  .wo-accordion {
    border: 1.5px solid var(--color-border); border-radius: 3px;
    margin-bottom: 20px; overflow: hidden;
  }
  .wo-accordion-btn {
    width: 100%; display: flex; align-items: center; justify-content: space-between;
    padding: 14px 16px; background: var(--color-surface);
    border: none; cursor: pointer; font-family: var(--font-heading);
    font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--color-ink);
  }
  .wo-accordion-btn:hover { background: #ebebeb; }
  .ac-icon { width: 18px; height: 18px; stroke: var(--color-body); transition: transform 0.25s; }
  .wo-accordion.open .ac-icon { transform: rotate(180deg); }
  .wo-accordion-body {
    max-height: 0; overflow: hidden; transition: max-height 0.35s ease;
    padding: 0 16px;
  }
  .wo-accordion.open .wo-accordion-body { max-height: 800px; padding: 16px; }

  /* T&C */
  .wo-tc {
    border: 1.5px solid var(--color-border);
    border-radius: 3px; margin-bottom: 24px; overflow: hidden;
  }
  .tc-heading {
    font-family: var(--font-heading); font-size: 11px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink);
    margin: 0; padding: 14px 20px 0;
    background: var(--color-surface);
  }
  .tc-scroll-hint {
    font-family: var(--font-body); font-size: 11px; color: var(--color-brand);
    margin: 0; padding: 4px 20px 10px;
    background: var(--color-surface);
  }
  .tc-scroll-hint.done { color: #5a8a5a; }
  .tc-scroll {
    height: 300px; overflow-y: auto;
    padding: 16px 20px; background: #fff;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .tc-scroll p {
    font-family: var(--font-body); font-size: 12.5px; color: var(--color-body);
    line-height: 1.7; margin: 0 0 12px;
  }
  .tc-scroll p strong { color: var(--color-ink); }
  .tc-section {
    font-family: var(--font-heading) !important; font-size: 11px !important;
    font-weight: 700 !important; letter-spacing: 0.12em !important;
    text-transform: uppercase !important; color: var(--color-ink) !important;
    margin: 20px 0 8px !important; border-top: 1px solid var(--color-border);
    padding-top: 16px !important;
  }
  .checkbox-label {
    display: flex; align-items: flex-start; gap: 10px;
    font-family: var(--font-body); font-size: 14px; color: var(--color-ink);
    cursor: pointer; padding: 14px 20px;
    background: var(--color-surface);
  }
  .checkbox-label input[disabled] { opacity: 0.35; cursor: not-allowed; }
  .checkbox-label input { accent-color: var(--color-brand); width: 16px; height: 16px; flex: 0 0 16px; margin-top: 2px; }
  .checkbox-label {
    display: flex; align-items: flex-start; gap: 10px;
    font-family: var(--font-body); font-size: 14px; color: var(--color-ink);
    cursor: pointer; margin-top: 12px;
  }
  .checkbox-label input { accent-color: var(--color-brand); width: 16px; height: 16px; flex: 0 0 16px; margin-top: 2px; }

  .wo-btn {
    width: auto; padding: 15px 44px;
    display: block; margin-left: auto; margin-right: auto;
    background: var(--color-brand); color: #fff; border: none; border-radius: 3px;
    font-family: var(--font-heading); font-size: 15px; font-weight: 700;
    letter-spacing: 0.04em; cursor: pointer; transition: background 0.18s;
  }
  .wo-btn:hover { background: var(--color-brand-dark); }
  .wo-btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .wo-uploading { font-size: 13px; color: var(--color-body); margin: 12px 0 0; }

  /* Required-field pill markers (appear on submit next to an empty required field's label) */
  .wo-group, .wo-tc-row, .upload-zone { position: relative; }
  .req-pill {
    display: inline-flex; align-items: center; gap: 5px; vertical-align: middle;
    background: #E03131; color: #fff; font-family: var(--font-heading);
    font-size: 10px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
    padding: 3px 9px 3px 8px; border-radius: 999px; white-space: nowrap;
    box-shadow: 0 3px 9px rgba(224,49,49,0.32); margin-left: 4px;
  }
  .field-invalid input, .field-invalid select, .field-invalid textarea,
  input.field-invalid, select.field-invalid, textarea.field-invalid,
  .upload-zone.field-invalid { border-color: #E03131 !important; background: #fff7f7; }

  /* Terms row + Review button (replaces the scroll-to-unlock box) */
  .wo-tc-row { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 12px 14px; margin-bottom: 30px; }
  .wo-tc-title { font-family: var(--font-heading); font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-ink); }
  .wo-review-btn {
    background: none; border: 1.5px solid var(--color-brand); color: var(--color-brand);
    font-family: var(--font-heading); font-size: 12px; font-weight: 700; letter-spacing: 0.05em;
    text-transform: uppercase; padding: 9px 18px; border-radius: 3px; cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .wo-review-btn:hover { background: var(--color-brand); color: #fff; }
  .wo-tc-agreed { display: none; align-items: center; gap: 8px; color: #2b8a3e; font-size: 13px; font-weight: 600; }
  .wo-tc-row.agreed .wo-review-btn { display: none; }
  .wo-tc-row.agreed .wo-tc-agreed { display: inline-flex; }

  /* Terms modal */
  .wo-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); display: none; align-items: center; justify-content: center; padding: 24px; z-index: 1000; }
  .wo-overlay.open { display: flex; }
  .wo-modal { background: #fff; border-radius: 16px; box-shadow: 0 30px 80px rgba(0,0,0,0.4); width: 100%; max-width: 640px; max-height: 82vh; display: flex; flex-direction: column; overflow: hidden; }
  .wo-modal-head { display: flex; align-items: center; justify-content: space-between; padding: 22px 26px 14px; }
  .wo-modal-head h2 { font-family: var(--font-heading); font-size: 18px; font-weight: 800; margin: 0; color: var(--color-ink); }
  .wo-modal-x { width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--color-border); background: #fff; color: #555; font-size: 20px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .wo-modal-x:hover { background: var(--color-surface); }
  .wo-modal-body { overflow-y: auto; padding: 4px 26px 8px; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .wo-modal-body p { font-family: var(--font-body); font-size: 12.5px; line-height: 1.7; color: var(--color-body); margin: 12px 0; }
  .wo-modal-body p strong { color: var(--color-ink); }
  .wo-modal-body .tc-section { font-family: var(--font-heading); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink); margin: 18px 0 8px; border-top: 1px solid var(--color-border); padding-top: 14px; }
  .wo-modal-foot { display: flex; align-items: center; justify-content: space-between; padding: 16px 26px; }
  .wo-modal-cancel { background: none; border: none; color: #888; font-family: var(--font-body); font-size: 14px; text-decoration: underline; cursor: pointer; }
  .wo-modal-cancel:hover { color: var(--color-ink); }
  .wo-modal-agree { background: var(--color-brand); color: #fff; border: none; border-radius: 6px; font-family: var(--font-heading); font-size: 14px; font-weight: 700; padding: 11px 26px; cursor: pointer; }
  .wo-modal-agree:hover { background: var(--color-brand-dark); }

  /* Stack the payment / authorized-by / date row in narrower windows so the
     native date picker can't open past the right edge of the screen. */
  @media (max-width: 800px) {
    .wo-row-auth { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .wo-row { grid-template-columns: 1fr; }
    .wo-row3 { grid-template-columns: 1fr; }
    .wo-grid-3 { grid-template-columns: 1fr 1fr; }
    .wo-grid-csz { grid-template-columns: 1fr; }
    .upload-zones { grid-template-columns: 1fr; }
    .loc-other-input { width: 100% !important; }
  }
</style>

<script>
  // Accordion toggle
  document.getElementById('acToggle')?.addEventListener('click', () => {
    document.querySelector('.wo-accordion')?.classList.toggle('open');
  });

  // Reveal credit-card detail fields only when Method Type = Credit Card
  const paySelect = document.getElementById('wo-payment') as HTMLSelectElement | null;
  const ccFields = document.getElementById('cc-fields');
  paySelect?.addEventListener('change', () => {
    if (ccFields) ccFields.hidden = paySelect.value !== 'Credit Card';
  });

  // "Other" location enables text input
  document.querySelectorAll('input[name="location"]').forEach((radio) => {
    radio.addEventListener('change', () => {
      const other = document.getElementById('locOtherText') as HTMLInputElement;
      other.disabled = (radio as HTMLInputElement).value !== 'Other';
      if (!other.disabled) other.focus();
    });
  });

  // ── Terms modal (opens the full terms; "I Agree" records agreement) ──
  let termsAgreed = false;
  const termsOverlay = document.getElementById('termsOverlay') as HTMLElement;
  const termsBody = document.getElementById('termsBody') as HTMLElement;
  function openTerms() { termsOverlay.classList.add('open'); termsOverlay.setAttribute('aria-hidden', 'false'); if (termsBody) termsBody.scrollTop = 0; }
  function closeTerms() { termsOverlay.classList.remove('open'); termsOverlay.setAttribute('aria-hidden', 'true'); }
  document.getElementById('reviewTerms')?.addEventListener('click', openTerms);
  document.getElementById('termsClose')?.addEventListener('click', closeTerms);
  document.getElementById('termsCancel')?.addEventListener('click', closeTerms);
  termsOverlay?.addEventListener('click', (e) => { if (e.target === termsOverlay) closeTerms(); });
  document.getElementById('termsAgree')?.addEventListener('click', () => {
    termsAgreed = true;
    (document.getElementById('wo-terms') as HTMLInputElement).value = 'yes';
    const tg = document.getElementById('termsgroup');
    tg?.classList.add('agreed');
    tg?.querySelector('.req-pill')?.remove();
    closeTerms();
  });

  // File upload zones with add/remove
  function setupUpload(inputId: string, listId: string) {
    const input = document.getElementById(inputId) as HTMLInputElement;
    const list = document.getElementById(listId)!;
    const files: File[] = [];

    input.addEventListener('change', () => {
      Array.from(input.files ?? []).forEach(f => {
        if (!files.find(x => x.name === f.name && x.size === f.size)) files.push(f);
      });
      render();
      sync();
    });

    function render() {
      list.innerHTML = '';
      files.forEach((f, i) => {
        const li = document.createElement('li');
        li.style.cssText = 'display:flex;align-items:center;padding:3px 6px 3px 10px;background:#f5f5f5;border:1px solid #e0e0e0;border-radius:3px;margin-top:5px;';
        const name = document.createElement('span');
        name.textContent = f.name;
        name.style.cssText = 'font-size:11px;color:#666;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = '✕';
        btn.style.cssText = 'background:none;border:none;cursor:pointer;padding:0 2px;margin-left:6px;font-size:9px;color:#999;line-height:1;flex-shrink:0;';
        btn.addEventListener('mouseover', () => btn.style.color = '#c0392b');
        btn.addEventListener('mouseout', () => btn.style.color = '#999');
        btn.addEventListener('click', () => { files.splice(i, 1); render(); sync(); });
        li.appendChild(name);
        li.appendChild(btn);
        list.appendChild(li);
      });
    }

    function sync() {
      const dt = new DataTransfer();
      files.forEach(f => dt.items.add(f));
      input.files = dt.files;
    }
  }

  setupUpload('upload-sow', 'sow-list');
  setupUpload('upload-pics', 'pics-list');
  setupUpload('upload-po', 'po-list');

  // Phone / Fax — format as a US number while typing: (123) 456-7890
  function formatUsPhone(el: HTMLInputElement) {
    const d = el.value.replace(/\D/g, '').slice(0, 10);
    let out = d;
    if (d.length > 6) out = `(${d.slice(0, 3)}) ${d.slice(3, 6)}-${d.slice(6)}`;
    else if (d.length > 3) out = `(${d.slice(0, 3)}) ${d.slice(3)}`;
    else if (d.length > 0) out = `(${d.slice(0, 3)}`;
    el.value = out;
  }
  ['wo-phone', 'cc-phone'].forEach((id) => {
    const el = document.getElementById(id) as HTMLInputElement | null;
    el?.addEventListener('input', () => formatUsPhone(el));
  });

  // Set auth date to today by default
  const today = new Date().toISOString().split('T')[0];
  (document.getElementById('wo-auth-date') as HTMLInputElement).value = today;

  // ── Submit: compress photos client-side, then native POST so the endpoint's
  //    303 redirect to the thank-you page works (a cross-origin fetch would be
  //    blocked by CORS). Photos are resized to keep the request under Vercel's
  //    ~4.5 MB ingress cap; SOW / PO files pass through untouched. ──
  const MAX_DIM = 1600;
  const JPEG_Q = 0.7;

  function compressImage(file: File): Promise<File> {
    return new Promise((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(url);
        let width = img.naturalWidth, height = img.naturalHeight;
        if (width > MAX_DIM || height > MAX_DIM) {
          if (width >= height) { height = Math.round((height * MAX_DIM) / width); width = MAX_DIM; }
          else { width = Math.round((width * MAX_DIM) / height); height = MAX_DIM; }
        }
        const canvas = document.createElement('canvas');
        canvas.width = width; canvas.height = height;
        const ctx = canvas.getContext('2d');
        if (!ctx) { reject(new Error('no-2d-context')); return; }
        ctx.drawImage(img, 0, 0, width, height);
        canvas.toBlob((blob) => {
          if (!blob) { reject(new Error('toBlob-failed')); return; }
          const name = file.name.replace(/\.[^.]+$/, '') + '.jpg';
          resolve(new File([blob], name, { type: 'image/jpeg', lastModified: Date.now() }));
        }, 'image/jpeg', JPEG_Q);
      };
      img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('img-load-failed')); };
      img.src = url;
    });
  }

  async function compressPhotos(input: HTMLInputElement | null) {
    if (!input?.files?.length) return;
    const dt = new DataTransfer();
    for (const file of Array.from(input.files)) {
      if (!file.type.startsWith('image/')) { dt.items.add(file); continue; }
      try { dt.items.add(await compressImage(file)); }
      catch { dt.items.add(file); } // keep the original if it can't be re-encoded
    }
    input.files = dt.files;
  }

  const form = document.getElementById('wo-form') as HTMLFormElement;
  const photosInput = document.getElementById('upload-pics') as HTMLInputElement;
  const loadTime = Date.now();

  // ── Required-field validation with red pills ──
  function clearMarks() {
    form.querySelectorAll('.req-pill').forEach(p => p.remove());
    form.querySelectorAll('.field-invalid').forEach(el => el.classList.remove('field-invalid'));
  }
  function addPill(group: Element | null) {
    if (!group || group.querySelector('.req-pill')) return;
    // Section titles are checked BEFORE a plain <label>: inside an upload zone the "Choose Files"
    // control is itself a <label>, so a label-first lookup pinned the pill inside that button
    // instead of beside the zone's title. Ordinary field groups have neither of the first two,
    // so they still fall through to their own <label>.
    const label = group.querySelector('.upload-zone-label') || group.querySelector('.wo-tc-title') || group.querySelector('label');
    if (!label) return;
    const pill = document.createElement('span'); pill.className = 'req-pill'; pill.textContent = 'Required';
    // Styled inline (not via the scoped stylesheet) because Astro scopes CSS to elements it renders,
    // and this pill is created at runtime, so a scoped .req-pill rule would never match it.
    pill.style.cssText = 'display:inline-flex;align-items:center;vertical-align:middle;background:#E03131;color:#fff;font-size:10px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;padding:3px 9px 3px 8px;border-radius:999px;white-space:nowrap;box-shadow:0 3px 9px rgba(224,49,49,0.32);margin-left:6px;';
    label.appendChild(pill);
  }
  function markField(name: string, first: Element | null): Element | null {
    const el = form.querySelector(`[name="${name}"]`) as HTMLInputElement | null;
    if (el && !el.value.trim()) { el.classList.add('field-invalid'); const g = el.closest('.wo-group'); addPill(g); return first || g; }
    return first;
  }
  function markRadio(name: string, first: Element | null): Element | null {
    if (!form.querySelector(`input[name="${name}"]:checked`)) {
      const g = (form.querySelector(`input[name="${name}"]`) as HTMLElement | null)?.closest('.wo-group') || null;
      addPill(g); return first || g;
    }
    return first;
  }
  function validate(): Element | null {
    clearMarks();
    let first: Element | null = null;
    ['name','phone','email','billing_street','billing_city','billing_state','billing_zip',
     'aircraft_type','registration_number','aircraft_serial','expected_departure',
     'aircraft_total_time','aircraft_total_landings',
     'service_required','payment_method','authorized_by','authorization_date'].forEach(n => { first = markField(n, first); });
    ['location','aog'].forEach(n => { first = markRadio(n, first); });
    const locOther = document.getElementById('locOtherText') as HTMLInputElement | null;
    if (form.querySelector('input[name="location"][value="Other"]:checked') && locOther && !locOther.value.trim()) {
      locOther.classList.add('field-invalid'); const g = locOther.closest('.wo-group'); addPill(g); first = first || g;
    }
    const sow = document.getElementById('upload-sow') as HTMLInputElement;
    if (!sow.files || !sow.files.length) { const zone = sow.closest('.upload-zone'); if (zone) { zone.classList.add('field-invalid'); addPill(zone); first = first || zone; } }
    if (paySelect && paySelect.value === 'Credit Card') {
      ['cc_name','cc_phone','cc_billing_street','cc_billing_city','cc_billing_state','cc_billing_zip'].forEach(n => { first = markField(n, first); });
      first = markRadio('cc_type', first);
    }
    if (!termsAgreed) { const g = document.getElementById('termsgroup'); addPill(g); first = first || g; }
    // The Aircraft Details drawer collapses to zero height, so a required field inside it would be
    // flagged where nobody can see it, and scrolled to while still hidden. Open the drawer whenever
    // it holds a flagged field, so the customer is never told to fix something they cannot see.
    if (form.querySelector('#acBody .field-invalid, #acBody .req-pill')) {
      document.querySelector('.wo-accordion')?.classList.add('open');
    }
    return first;
  }
  // Clear a field's red outline as the customer fixes it
  form.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (el && el.value && typeof el.value === 'string' && el.value.trim()) el.classList.remove('field-invalid');
  });

  // ── Direct-to-storage upload (past the ~4.5 MB request wall) ──
  const ENDPOINT = 'https://www.recoilone.com/api/forms';
  async function uploadOne(field: string, file: File, uploadId: string) {
    const r = await fetch(`${ENDPOINT}/upload-url`, {
      method: 'POST', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ brand: 'jetavenue.net', field, filename: file.name, size: file.size, uploadId }),
    });
    if (!r.ok) throw new Error('upload-url ' + r.status);
    const { path, signedUrl } = await r.json();
    const put = await fetch(signedUrl, { method: 'PUT', headers: { 'content-type': file.type || 'application/octet-stream', 'x-upsert': 'true' }, body: file });
    if (!put.ok) throw new Error('put ' + put.status);
    return { field, path, name: file.name, contentType: file.type || 'application/octet-stream' };
  }

  const CAP = 10 * 1024 * 1024;
  const btn = form.querySelector('.wo-btn') as HTMLButtonElement;
  const resetBtn = () => { btn.disabled = false; btn.textContent = 'Submit Work Authorization →'; };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const first = validate();
    if (first) { first.scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }

    btn.disabled = true; btn.textContent = 'Preparing files…';
    try { await compressPhotos(photosInput); } catch { /* keep originals */ }

    const filesToUpload: { field: string; file: File }[] = [];
    ([['upload-sow', 'sow'], ['upload-pics', 'photos'], ['upload-po', 'po']] as const).forEach(([id, field]) => {
      const inp = document.getElementById(id) as HTMLInputElement;
      Array.from(inp.files ?? []).forEach(f => filesToUpload.push({ field, file: f }));
    });

    const total = filesToUpload.reduce((s, x) => s + x.file.size, 0);
    if (total > CAP) {
      alert(`Your attached files total ${(total / 1048576).toFixed(1)} MB. Please keep the combined size under 10 MB — remove or shrink a file, then submit again.`);
      resetBtn(); return;
    }

    (document.getElementById('wo-fillms') as HTMLInputElement).value = String(Date.now() - loadTime);

    btn.textContent = 'Uploading files…';
    const uploadId = 'u' + Math.random().toString(36).slice(2, 10);
    const refs: Array<{ field: string; path: string; name: string; contentType: string }> = [];
    try {
      for (const { field, file } of filesToUpload) refs.push(await uploadOne(field, file, uploadId));
    } catch (err) {
      alert('There was a problem uploading your files. Please try again, or reduce their size.');
      resetBtn(); return;
    }

    (document.getElementById('wo-uploaded') as HTMLInputElement).value = JSON.stringify(refs);
    // Clear the file inputs so the native POST carries only fields + references (tiny, never hits the wall)
    ['upload-sow', 'upload-pics', 'upload-po'].forEach(id => { try { (document.getElementById(id) as HTMLInputElement).files = new DataTransfer().files; } catch {} });

    btn.textContent = 'Submitting…';
    form.submit(); // native POST (fields + references only) → endpoint → 303 → thank-you
  });
</script>
